# Your public HTTPS origin, without a trailing slash. Use localhost only for local tests.
PUBLIC_URL=https://helmies.fi
DATA_DIR=/data

# Hostinger Email examples. Confirm your mailbox provider; Titan uses different hosts.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURITY=ssl
IMAP_HOST=imap.hostinger.com
IMAP_PORT=993
# Optional: exact existing Sent folder name; leave blank to keep sent copies only in the dashboard.
IMAP_SENT_FOLDER=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

# Server-side only. Choose a model available in your OpenAI API project.
OPENAI_API_KEY=
OPENAI_MODEL=
BRAVE_SEARCH_API_KEY=

# For compose.traefik.yml; match your EXISTING Traefik setup.
SITE_HOST=helmies.fi
TRAEFIK_NETWORK=proxy
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERT_RESOLVER=letsencrypt
